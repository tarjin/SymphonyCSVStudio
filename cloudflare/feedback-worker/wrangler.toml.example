# Copy to wrangler.toml after creating a D1 database; DO NOT commit account credentials.
name = "symphonycsv-feedback-api"
main = "src/index.mjs"
compatibility_date = "2026-11-23"
workers_dev = true

[vars]
ALLOWED_ORIGINS = "https://symphonycsvstudio.com,https://www.symphonycsvstudio.com"
PRODUCT_PHASE = "LABS"
TURNSTILE_REQUIRED = "true"

[[d1_databases]]
binding = "DB"
database_name = "symphonycsv-feedback"
database_id = "REPLACE_WITH_ACTUAL_CLOUDFLARE_D1_DATABASE_ID"
migrations_dir = "migrations"
